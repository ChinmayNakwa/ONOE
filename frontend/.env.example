# Address printed by the deploy script (forge script ... --broadcast)
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Government node key. Its address must be the SLIP_SIGNER_ADDRESS used at deploy time.
# It is only read by the server (app/api/auth-voter), never sent to the browser.
SLIP_SIGNER_PRIVATE_KEY=0x

# Server-only secret mixed into voter IDs to build nullifiers. Use any long random string.
VOTER_SECRET=change-me-to-a-long-random-string
