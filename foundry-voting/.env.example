# Admin (ECI) wallet that deploys the contract and runs the election.
# For local Anvil use account #0's private key from the anvil startup output.
PRIVATE_KEY=0x

# Address of the government node's signing key (not its private key).
# For local Anvil use account #1's address.
SLIP_SIGNER_ADDRESS=0x0000000000000000000000000000000000000000
